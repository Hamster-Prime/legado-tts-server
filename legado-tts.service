[Unit]
Description=Legado TTS Service
Documentation=https://github.com/Hamster-Prime/legado-tts-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Install layout assumed by this unit:
#   /opt/legado-tts          app.py, gunicorn.conf.py, requirements.txt
#   /var/lib/legado-tts      config.json, stats.json  (StateDirectory, below)
#
# Create the service account once before enabling:
#   useradd --system --no-create-home --shell /usr/sbin/nologin legado-tts
User=legado-tts
Group=legado-tts

WorkingDirectory=/opt/legado-tts
ExecStart=/usr/bin/python3 -u /opt/legado-tts/app.py

# systemd creates/chowns /var/lib/legado-tts for us.
StateDirectory=legado-tts
Environment=PORT=8080
Environment=CONFIG_FILE=/var/lib/legado-tts/config.json
Environment=STATS_FILE=/var/lib/legado-tts/stats.json
# Set a token to protect the admin API and WebUI:
# Environment=ADMIN_TOKEN=change-me

# ── Hardening ──
# The service only needs to read its own directory, write state, and talk HTTPS
# to the upstream TTS providers.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Ports below 1024 need this; unnecessary when PORT >= 1024 as above.
# AmbientCapabilities=CAP_NET_BIND_SERVICE

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
